# The overlay is inserted in web content, so it needs to be accessible from
# resource://content-accessible/.
FINAL_TARGET = "dist/bin"

CONTENT_ACCESSIBLE_FILES.icons += [
    "/browser/components/miniwindow/assets/mini-window.svg",
    "/browser/themes/shared/downloads/downloads.svg",
]

CONTENT_ACCESSIBLE_FILES.screenshots += [
    "overlay.css",
]

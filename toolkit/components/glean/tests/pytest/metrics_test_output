    /// Turns a static label's enum value (its index) into the label string.
    pub(crate) fn labeled_enum_to_str(metric_id: u32, label: u16) -> &'static str {
        if let Some(cell) = LABELED_BOOLEAN_MAP.get(&BaseMetricId(metric_id)) {
            return cell.def().labels.get(label as usize).copied().unwrap_or("__other__");
        }
        if let Some(cell) = LABELED_COUNTER_MAP.get(&BaseMetricId(metric_id)) {
            return cell.def().labels.get(label as usize).copied().unwrap_or("__other__");
        }
        if let Some(cell) = LABELED_CUSTOM_DISTRIBUTION_MAP.get(&BaseMetricId(metric_id)) {
            return cell.def().labels.get(label as usize).copied().unwrap_or("__other__");
        }
        if let Some(cell) = LABELED_MEMORY_DISTRIBUTION_MAP.get(&BaseMetricId(metric_id)) {
            return cell.def().labels.get(label as usize).copied().unwrap_or("__other__");
        }
        if let Some(cell) = LABELED_QUANTITY_MAP.get(&BaseMetricId(metric_id)) {
            return cell.def().labels.get(label as usize).copied().unwrap_or("__other__");
        }
        if let Some(cell) = LABELED_STRING_MAP.get(&BaseMetricId(metric_id)) {
            return cell.def().labels.get(label as usize).copied().unwrap_or("__other__");
        }
        if let Some(cell) = LABELED_TIMING_DISTRIBUTION_MAP.get(&BaseMetricId(metric_id)) {
            return cell.def().labels.get(label as usize).copied().unwrap_or("__other__");
        }
        panic!("Can't turn label enum to string for metric {} which isn't a labeled metric", metric_id)
    }

    pub(crate) fn labeled_submetric_id_get(metric_id: u32, label: &str) -> u32 {
        if let Some(cell) = LABELED_BOOLEAN_MAP.get(&BaseMetricId(metric_id)) {
            return cell.get_submetric_id(label);
        }
        if let Some(cell) = LABELED_COUNTER_MAP.get(&BaseMetricId(metric_id)) {
            return cell.get_submetric_id(label);
        }
        if let Some(cell) = LABELED_CUSTOM_DISTRIBUTION_MAP.get(&BaseMetricId(metric_id)) {
            return cell.get_submetric_id(label);
        }
        if let Some(cell) = LABELED_MEMORY_DISTRIBUTION_MAP.get(&BaseMetricId(metric_id)) {
            return cell.get_submetric_id(label);
        }
        if let Some(cell) = LABELED_QUANTITY_MAP.get(&BaseMetricId(metric_id)) {
            return cell.get_submetric_id(label);
        }
        if let Some(cell) = LABELED_STRING_MAP.get(&BaseMetricId(metric_id)) {
            return cell.get_submetric_id(label);
        }
        if let Some(cell) = LABELED_TIMING_DISTRIBUTION_MAP.get(&BaseMetricId(metric_id)) {
            return cell.get_submetric_id(label);
        }
        panic!("No labeled metric for id {}", metric_id)
    }


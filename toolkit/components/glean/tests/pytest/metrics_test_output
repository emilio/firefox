    /// Measure the allocation size of all labeled metrics.
    ///
    /// Labeled metrics do allocate additional memory at runtime for the cache of instantiated submetrics.
    /// These are included in the `size_of` measurement automatically.
    fn fog_labeled_alloc_size(ops: &mut malloc_size_of::MallocSizeOfOps) -> usize {
        let mut n = 0;
        for cell in super::__glean_table::LABELED_BOOLEAN_TABLE.iter() {
            if let Some(metric) = cell.peek() {
                n += metric.size_of(ops);
            }
        }
        for cell in super::__glean_table::LABELED_COUNTER_TABLE.iter() {
            if let Some(metric) = cell.peek() {
                n += metric.size_of(ops);
            }
        }
        for cell in super::__glean_table::LABELED_CUSTOM_DISTRIBUTION_TABLE.iter() {
            if let Some(metric) = cell.peek() {
                n += metric.size_of(ops);
            }
        }
        for cell in super::__glean_table::LABELED_MEMORY_DISTRIBUTION_TABLE.iter() {
            if let Some(metric) = cell.peek() {
                n += metric.size_of(ops);
            }
        }
        for cell in super::__glean_table::LABELED_QUANTITY_TABLE.iter() {
            if let Some(metric) = cell.peek() {
                n += metric.size_of(ops);
            }
        }
        for cell in super::__glean_table::LABELED_STRING_TABLE.iter() {
            if let Some(metric) = cell.peek() {
                n += metric.size_of(ops);
            }
        }
        for cell in super::__glean_table::LABELED_TIMING_DISTRIBUTION_TABLE.iter() {
            if let Some(metric) = cell.peek() {
                n += metric.size_of(ops);
            }
        }
        n
    }

    fn fog_submetric_alloc_size(ops: &mut malloc_size_of::MallocSizeOfOps) -> usize {
        let mut n = 0;

        n += once_cell::sync::Lazy::get(&submetric_maps::LABELED_METRICS_TO_IDS).map_or(0, |m| {
            let lock = m.read().unwrap();
            (*lock).size_of(ops)
        });
        n += once_cell::sync::Lazy::get(&submetric_maps::LABELED_ENUMS_TO_IDS).map_or(0, |m| {
            let lock = m.read().unwrap();
            (*lock).size_of(ops)
        });

        n += once_cell::sync::Lazy::get(&submetric_maps::BOOLEAN_MAP).map_or(0, |m| {
            // The values are behind an `Arc`. We don't want to measure them.
            // We only measure the enclosing size of the values.
            let lock = m.read().unwrap();
            malloc_size_of::MallocShallowSizeOf::shallow_size_of(&*lock, ops)
        });
        n += once_cell::sync::Lazy::get(&submetric_maps::COUNTER_MAP).map_or(0, |m| {
            // The values are behind an `Arc`. We don't want to measure them.
            // We only measure the enclosing size of the values.
            let lock = m.read().unwrap();
            malloc_size_of::MallocShallowSizeOf::shallow_size_of(&*lock, ops)
        });
        n += once_cell::sync::Lazy::get(&submetric_maps::CUSTOM_DISTRIBUTION_MAP).map_or(0, |m| {
            // The values are behind an `Arc`. We don't want to measure them.
            // We only measure the enclosing size of the values.
            let lock = m.read().unwrap();
            malloc_size_of::MallocShallowSizeOf::shallow_size_of(&*lock, ops)
        });
        n += once_cell::sync::Lazy::get(&submetric_maps::MEMORY_DISTRIBUTION_MAP).map_or(0, |m| {
            // The values are behind an `Arc`. We don't want to measure them.
            // We only measure the enclosing size of the values.
            let lock = m.read().unwrap();
            malloc_size_of::MallocShallowSizeOf::shallow_size_of(&*lock, ops)
        });
        n += once_cell::sync::Lazy::get(&submetric_maps::QUANTITY_MAP).map_or(0, |m| {
            // The values are behind an `Arc`. We don't want to measure them.
            // We only measure the enclosing size of the values.
            let lock = m.read().unwrap();
            malloc_size_of::MallocShallowSizeOf::shallow_size_of(&*lock, ops)
        });
        n += once_cell::sync::Lazy::get(&submetric_maps::STRING_MAP).map_or(0, |m| {
            // The values are behind an `Arc`. We don't want to measure them.
            // We only measure the enclosing size of the values.
            let lock = m.read().unwrap();
            malloc_size_of::MallocShallowSizeOf::shallow_size_of(&*lock, ops)
        });
        n += once_cell::sync::Lazy::get(&submetric_maps::TIMING_DISTRIBUTION_MAP).map_or(0, |m| {
            // The values are behind an `Arc`. We don't want to measure them.
            // We only measure the enclosing size of the values.
            let lock = m.read().unwrap();
            malloc_size_of::MallocShallowSizeOf::shallow_size_of(&*lock, ops)
        });
        n
    }

